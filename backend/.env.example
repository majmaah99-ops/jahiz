# ============================================================
# JAHIZ Backend - Environment Variables Template
# انسخ هذا الملف إلى .env قبل التشغيل
# ============================================================

# ---------- App ----------
APP_NAME=JAHIZ
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql://jahiz:jahiz@localhost:5432/jahiz
REDIS_URL=redis://localhost:6379/0

# ---------- Open Banking (Lean Technologies) ----------
LEAN_APP_ID=your_lean_app_id_here
LEAN_APP_SECRET=your_lean_secret_here
LEAN_SANDBOX=true

# ---------- ZATCA e-Invoicing ----------
ZATCA_CLIENT_ID=your_zatca_client_id_here
ZATCA_CLIENT_SECRET=your_zatca_secret_here
ZATCA_ENV=sandbox

# ---------- LLM (optional - for production bank reports) ----------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------- Security ----------
JWT_SECRET=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=32-byte-encryption-key-here

# ---------- CORS ----------
ALLOWED_ORIGINS=http://localhost:3000,https://jahiz.vercel.app
